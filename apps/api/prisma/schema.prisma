generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String
  activateLink Json?
  resetLink    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       UserRole[]
  refreshTokens RefreshToken[]
  customerOrders Order[] @relation("CustomerOrders")
  transactions Transaction[]

  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  token          String?
  expires        DateTime?
  created        DateTime  @default(now())
  createdByIp    String?
  revoked        DateTime?
  revokedByIp    String?
  replacedByToken String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  desc      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menus     Menu[]

  @@map("categories")
}

model Menu {
  id          String      @id @default(cuid())
  name        String      @unique
  desc        String?
  image       String
  categoryId  String      @map("id_category")
  price       Float
  promo       Float
  duration    Float
  isAvailable Boolean
  isFavorite  Boolean
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("menus")
}

model DiningTable {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("tables")
}

model Order {
  id          String      @id @default(cuid())
  customerId  String?     @map("id_customer")
  tableId     String?     @map("id_table")
  quality     Float
  duration    Float
  promo       Float
  price       Float
  totalPrice  Float       @map("total_price")
  note        String?
  status      OrderStatus
  estimatedReadyAt DateTime @map("estimated_ready_at")
  expires     DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customer    User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  table       DiningTable? @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  transaction Transaction?

  @@index([customerId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("id_order")
  menuId     String   @map("id_menu")
  quality    Float
  duration   Float
  promo      Float
  price      Float
  totalPrice Float    @map("total_price")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id])
  menu       Menu     @relation(fields: [menuId], references: [id])

  @@index([orderId])
  @@index([menuId])
  @@map("itemorders")
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  orderId   String            @unique @map("id_order")
  note      String?
  status    TransactionStatus
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id])
  order     Order             @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("transactions")
}

enum OrderStatus {
  PENDING @map("pending")
  CASH    @map("cash")
  VIRTUAL @map("virtual")
}

enum TransactionStatus {
  PENDING @map("pending")
  PROCESSING @map("processing")
  DONE    @map("done")
}
