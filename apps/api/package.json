{
  "name": "@bukit-delight/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "start": "node ./dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.js\" \"src/**/*.jsx\" test",
    "test": "node --import tsx --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import": "tsx prisma/import-mongodb.ts"
  },
  "dependencies": {
    "@bukit-delight/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^8.2.0",
    "express": "^4.16.4",
    "joi": "^17.3.0",
    "jsonwebtoken": "^8.5.1",
    "morgan": "~1.9.1",
    "multer": "^1.4.2",
    "nodemailer": "^6.4.15",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "socket.io": "^3.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "nodemon": "^2.0.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
