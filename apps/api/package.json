{
  "name": "@bukit-delight/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --watch ../../packages/shared/src --ext ts --exec \"tsx src/server.ts\"",
    "start": "node ./dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint test",
    "test": "node --import tsx --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import": "tsx prisma/import-mongodb.ts"
  },
  "dependencies": {
    "@bukit-delight/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
